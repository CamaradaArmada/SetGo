package-as: SetGo

manual-changelog:
  filename: CURSEFORGE.md
  markup-type: markdown

move-folders:
  SetGo/SetGo: SetGo
  SetGo/SetGo_Fetch: SetGo_Fetch
  SetGo/SetGo_Look: SetGo_Look
  SetGo/SetGo_Speak: SetGo_Speak
  SetGo/SetGo_Hide: SetGo_Hide
  SetGo/SetGo_BlessYou: SetGo_BlessYou

ignore:
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - MODULES.md
  - .gitignore
  - tests
